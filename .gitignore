# --- Large Raw Datasets (>100MB GitHub limit) ---
# Raw Kaggle 3M Twitter Customer Support dataset (~516 MB)
dataset/twcs/
dataset/twcs/*
*.csv.zip
*.tar.gz

# Keep sample.csv if needed for reference, but ignore large raw twcs dumps
# Note: golden_set.json and historical_knowledge_base.json in data/ are tracked for instant reproducibility

